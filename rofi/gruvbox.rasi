/*
 * ROFI Color theme — gruvbox, horizontal dmenu
 * Structure based on Dave Davenport's dmenu theme,
 * colors converted to gruvbox dark.
 * Save as ~/.config/rofi/gruvbox.rasi
 */

* {
    background-color:  #282828;
    border-color:      #83a598;
    text-color:        #ebdbb2;
    font:              "JetBrainsMono Nerd Font 11";
}

window {
    anchor:     north;
    location:   north;
    width:      100%;
    padding:    4px;
    children:   [ horibox ];
}

horibox {
    orientation: horizontal;
    children:    [ prompt, entry, listview ];
}

listview {
    layout:   horizontal;
    spacing:  5px;
    lines:    100;
}

entry {
    expand:  false;
    width:   10em;
}

element {
    padding: 0px 2px;
}

element selected {
    background-color: #928374;
    text-color:       #282828;
}

element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}
